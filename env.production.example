# InvoiceMe Production Environment Variables Template
# 
# Copy this file and rename to .env.production (or set as environment variables)
# DO NOT commit actual .env.production files to version control!
#
# For detailed instructions, see: docs/ENVIRONMENT_VARIABLES.md
#
# IMPORTANT: Use Spring Boot property names (SPRING_* prefix) for Spring Boot to read them automatically

# ============================================
# Backend Environment Variables (for EC2)
# ============================================

# Database Configuration (RDS PostgreSQL)
# Use SPRING_DATASOURCE_* for Spring Boot to read automatically
# Format: jdbc:postgresql://<RDS_ENDPOINT>:5432/invoiceme
SPRING_DATASOURCE_URL=jdbc:postgresql://your-rds-endpoint.region.rds.amazonaws.com:5432/invoiceme
SPRING_DATASOURCE_USERNAME=invoiceme_admin
SPRING_DATASOURCE_PASSWORD=your-secure-database-password-here

# JWT Configuration
# Generate a secure 256-bit (32 byte) secret key
# Example: openssl rand -base64 32
JWT_SECRET=your-256-bit-jwt-secret-key-here-minimum-32-characters

# Admin User Configuration
# Change these from defaults for production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password-here
ADMIN_EMAIL=admin@yourdomain.com

# CORS Configuration
# Use SPRING_WEB_CORS_ALLOWED_ORIGINS for Spring Boot
# Update with your EC2 IP or custom domain
# Format: http://your-ec2-ip:3000,http://localhost:3000
# Or: https://yourdomain.com
SPRING_WEB_CORS_ALLOWED_ORIGINS=http://your-ec2-ip:3000,http://localhost:3000

# Server Port (optional, defaults to 8080)
PORT=8080

# ============================================
# Frontend Environment Variables (for Next.js Server)
# ============================================

# API Configuration
# Update with your EC2 backend URL or custom domain
# Format: http://your-ec2-ip:8080/api
# Or: https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://your-ec2-public-ip:8080/api

# Environment
NEXT_PUBLIC_ENV=production

# ============================================
# AWS Configuration (for deployment scripts)
# ============================================

# AWS Region
AWS_REGION=us-east-1

# S3 Bucket Name (if using S3 for static hosting - not recommended for this app)
S3_BUCKET_NAME=invoiceme-frontend

# ============================================
# Notes on Property Naming
# ============================================
#
# Spring Boot automatically maps environment variables to properties:
# - SPRING_DATASOURCE_URL -> spring.datasource.url
# - SPRING_DATASOURCE_USERNAME -> spring.datasource.username
# - SPRING_DATASOURCE_PASSWORD -> spring.datasource.password
# - SPRING_WEB_CORS_ALLOWED_ORIGINS -> spring.web.cors.allowed-origins
#
# Alternative: You can also use the exact property name with dots replaced by underscores:
# - spring.datasource.url can be set as SPRING_DATASOURCE_URL
#
# ============================================
# Security Notes
# ============================================
# 
# 1. Generate strong passwords:
#    - Database password: Use AWS Secrets Manager or generate with: openssl rand -base64 32
#    - JWT secret: Use: openssl rand -base64 32
#    - Admin password: Use a strong, unique password
#
# 2. Store secrets securely:
#    - Use AWS Secrets Manager for production
#    - Use environment variables (not files) when possible
#    - Never commit secrets to version control
#
# 3. Rotate secrets regularly:
#    - Database passwords: Every 90 days
#    - JWT secrets: Every 180 days
#    - Admin passwords: Every 90 days
#
# 4. Restrict access:
#    - Use IAM roles for EC2 instances
#    - Use security groups to restrict database access
#    - Enable VPC Flow Logs for monitoring

